# Environment Configuration
# Copy this file to .env for local development
# For Vercel, set these in the Vercel dashboard under Environment Variables

# Application Environment
RACK_ENV=development
SINATRA_ENV=development

# Database Configuration
# For production, use PostgreSQL:
# DATABASE_URL=postgres://username:password@host:port/database
# For development, SQLite is used by default (configured in config/environment.rb)

# Session Secret (IMPORTANT: Change this in production!)
# Generate a secure secret with: ruby -rsecurerandom -e 'puts SecureRandom.hex(64)'
SESSION_SECRET=your_secure_session_secret_here

